{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Blend Room (Edge)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "serve",
      "userDataDir": true
    },
    {
      "name": "Blend Room (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "serve",
      "userDataDir": true
    },
    {
      "name": "Debug the server itself",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.js",
      "console": "integratedTerminal"
    }
  ]
}
